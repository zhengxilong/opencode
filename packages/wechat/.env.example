OPENCODE_WECHAT_ENABLED=true
OPENCODE_WECHAT_DEFAULT_PROJECT_DIR=/absolute/path/to/project
OPENCODE_WECHAT_ALLOWED_PROJECTS=/absolute/path/to/project,/absolute/path/to/project-b
OPENCODE_WECHAT_MAX_REPLY_LENGTH=2000
OPENCODE_WECHAT_STATUS_UPDATE_THRESHOLD_SECONDS=10
OPENCODE_WECHAT_REQUIRE_CONFIRMATION_FOR=git_push,rm,bulk_edit,exec_dangerous_command
OPENCODE_WECHAT_MANAGEMENT_API_BASE_URL=http://127.0.0.1:3001
